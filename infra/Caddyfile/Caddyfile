api.delvertrade.com {
  route {
    # 1) 画像: 最優先で MinIO へ
    @uploads path /public-uploads/*
    handle @uploads {
      header X-Route "uploads"
      reverse_proxy http://127.0.0.1:9000
      header Cache-Control "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400"
    }

    # 2) API: /api/* だけ、/api を剥いで 8000 へ
    @api path /api/*
    handle @api {
      header X-Route "api"
      header Access-Control-Allow-Origin "https://delvertrade.com"
      header Vary "Origin"
      header Access-Control-Allow-Credentials "true"
      header Access-Control-Allow-Methods "GET, POST, OPTIONS"
      header Access-Control-Allow-Headers "Content-Type, Authorization"
      uri strip_prefix /api
      reverse_proxy http://127.0.0.1:8000
    }

    # 3) その他は 404
    respond "Not found" 404
  }

  # OPTIONS は早期返却（どのパスでも）
  @preflight method OPTIONS
  handle @preflight {
    header Access-Control-Allow-Origin "https://delvertrade.com"
    header Access-Control-Allow-Credentials "true"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization"
    respond 204
  }
}