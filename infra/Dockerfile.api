FROM python:3.11-slim

WORKDIR /delver

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /delver/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY api/ /delver/api/

# Create data dirs
RUN mkdir -p /delver/data/strategies /delver/results

ENV PYTHONPATH=/delver
ENV PORT=8000

CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT} --workers 1
