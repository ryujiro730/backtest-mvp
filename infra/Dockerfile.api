FROM python:3.11-slim@sha256:6d98ca198cea726f2c86da2699594339a7b7ff08e49728797b4ed6e3b5c3b62a
# cache-bust: v3

WORKDIR /delver

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# API-specific requirements (exclude heavy/unavailable packages)
RUN pip install --no-cache-dir \
    fastapi==0.116.1 \
    uvicorn[standard]==0.35.0 \
    pydantic==2.11.7 \
    psycopg[binary] \
    celery==5.5.3 \
    redis==5.2.1 \
    boto3 \
    pandas \
    pyarrow \
    python-dotenv \
    stripe \
    requests

# Copy source
COPY . /delver/api/

# Create data dirs
RUN mkdir -p /delver/data/strategies /delver/results

ENV PYTHONPATH=/delver
ENV PORT=8000

CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT} --workers 1
