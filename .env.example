# Delver Standalone — .env.example
# cp .env.example .env して使う。変更不要な項目はそのままでOK。

# ── データベース（Docker内で自動設定） ──────────────────────────────
POSTGRES_URL=postgresql://delver:delverpass@postgres:5432/delverdb

# ── Redis（Docker内で自動設定） ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── データディレクトリ（Dockerボリューム経由） ──────────────────────
DATA_DIR=/delver/data/parquet

# ── FastAPI → フロントエンドのベースURL ────────────────────────────
FASTAPI_BASE_URL=http://api:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
